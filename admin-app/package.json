<?php get_header(); ?>
<main class="container" style="padding: 40px 0;">
    <h1>نتایج جستجو</h1>
    <?php if (have_posts()) : ?>
        <?php while (have_posts()) : the_post(); ?>
            <article>
                <h2><a href="<?php the_permalink(); ?>"><?php the_title(); ?></a></h2>
                <?php the_excerpt(); ?>
            </article>
        <?php endwhile; ?>
    <?php else : ?>
        <p>محتوایی برای جستجوی شما پیدا نشد.</p>
    <?php endif; ?>
</main>
<?php get_footer(); ?>
